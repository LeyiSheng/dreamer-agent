# Public repository: explicitly selected root entries only.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/pyproject.toml
!/release_manifest.json
!/dreamer_agent/
!/tests/
!/docs/
!/scripts/
!/.github/

/docs/*
!/docs/PLAN_V6.md
!/docs/PLAN_V5_SOURCE.md
!/docs/REPRODUCIBILITY.md
!/docs/THIRD_PARTY.md
/scripts/*
!/scripts/release.py
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml

# Runtime, credentials and large assets, including inside source directories.
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
.venv/
venv/
*.egg-info/
build/
dist/
.env
.env.*
!.env.example
*.pem
*.key
*.pt
*.pth
*.ckpt
*.safetensors
*.mp4
*.npy
*.npz
*.log

# Selected research documentation
!/docs/PLAN_V7.md
!/docs/PLAN_V7_AUDIT_20260926.md
!/docs/P1_PIPELINE.md
!/docs/P2_IMPLEMENTATION.md
!/docs/PAPER_AGENT_ROUTE.md
!/docs/RL_V6_V41_SYNTHESIS.md
!/docs/TRAINING_LOGIC.md
!/docs/TRAINING_SETUP.md
!/docs/SOURCE_SNAPSHOT.json
*.weights
*.model

# CI template can be enabled after workflow permission is available.
/.github/workflows/ci.yml
!/docs/ci.example.yml
